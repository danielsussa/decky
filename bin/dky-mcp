#!/usr/bin/env node
'use strict'

// MCP server that exposes the decky preview panel as tools.
// Talks to the decky app's local HTTP server (default 127.0.0.1:6790).
// Uses dynamic import so this CJS shebang script can load the ESM SDK.

const BASE = process.env.DECKY_URL || 'http://127.0.0.1:6790'

// Cards (tabs) in the center panel are created on demand by you, the session bot.
// A session starts with NO cards. Each preview_* call lands in a card.
const CARD_DESC =
  'Optional card/tab id, ALSO the filename of the shared .md at $DECKY_CARDS_DIR/<id>.md. ' +
  'Use SEMANTIC ids (e.g. "carol-agua", "pr/42-resumo") — "/" makes subfolders. ' +
  'Omit to use the focused card (or auto-create from the title slug). ' +
  'Distinct ids = multiple tabs at once; reuse an id to update/overwrite that card. ' +
  'These files are shared across sessions — prefer reusing existing ones (Glob/Read $DECKY_CARDS_DIR) over duplicating.'

const TOOLS = [
  {
    name: 'preview_show',
    description:
      'Display a file to the user in the decky preview panel (rendered/formatted). USE THIS — NOT Read — when the user asks to "show / view / open / see" a .md or .json file. Read brings content into your context but the user never sees the file; preview_show actually displays it to them in the decky UI. Use Read only when you need to programmatically process the content.',
    inputSchema: {
      type: 'object',
      properties: {
        path: { type: 'string', description: 'Absolute path to the file to render.' },
        card: { type: 'string', description: CARD_DESC }
