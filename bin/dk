#!/usr/bin/env node
'use strict'

const path = require('node:path')
const fs = require('node:fs/promises')

const BASE = process.env.DECK_URL || 'http://127.0.0.1:6790'

const HELP = `dk — controla o painel de preview e workspaces do deck.

uso:
  dk show <arquivo>            renderiza arquivo (.md, .markdown, .json)
  dk show --md <conteúdo|->    markdown inline (- lê stdin)
  dk show --json <json|->      JSON inline (parseado em tree)
  dk show --me [url]           live view do me daemon (default: http://127.0.0.1:6789)
  dk hide                      esvazia o preview
  dk current                   imprime o source atual (JSON)

  dk workspace [path]          abre uma sessão claude no path (default: cwd atual)
  dk workspace --shell [path]  mesmo, mas como sessão shell

  dk help                      esta mensagem

env:
  DECK_URL  base do http server interno (default ${BASE})
`

function die(msg, code = 1) {
  process.stderr.write(msg + '\n')
  process.exit(code)
}

async function readStdin() {
  process.stdin.setEncoding('utf-8')
  let data = ''
  for await (const chunk of process.stdin) data += chunk
  return data
}

async function post(p, body) {
  const headers = { 'content-type': 'application/json' }
  if (process.env.DECK_SESSION_ID) headers['x-deck-session-id'] = process.env.DECK_SESSION_ID
  const res = await fetch(BASE + p, {
    method: 'POST',
    headers,
    body: JSON.stringify(body)
  })
  if (!res.ok) {
    const text = await res.text().catch(() => '')
    die(`deck ${p}: HTTP ${res.status} ${text}`)
  }
  return res.json()
}

async function showFile(filePath) {
  const abs = path.resolve(filePath)
  try {
    await fs.access(abs)
  } catch {
    die(`arquivo não encontrado: ${abs}`)
  }
  const ext = path.extname(abs).toLowerCase()
  if (ext === '.md' || ext === '.markdown') {
    await post('/preview', { type: 'markdown', path: abs })
    return
  }
  if (ext === '.json') {
    const text = await fs.readFile(abs, 'utf-8')
    let value
    try {
      value = JSON.parse(text)
    } catch (err) {
      die(`json inválido em ${abs}: ${err.message}`)
    }
    await post('/preview', { type: 'json', value })
    return
  }
  die(`tipo desconhecido (${ext}). use --md ou --json explicitamente.`)
}

async function main() {
  const args = process.argv.slice(2)
  const cmd = args[0]

  if (!cmd || cmd === 'help' || cmd === '-h' || cmd === '--help') {
    process.stdout.write(HELP)
    return
  }

  if (cmd === 'hide' || cmd === 'clear') {
    await post('/preview/clear', {})
    return
  }

  if (cmd === 'current') {
    const res = await fetch(BASE + '/preview')
    process.stdout.write(JSON.stringify(await res.json(), null, 2) + '\n')
    return
  }

  if (cmd === 'workspace') {
    const subargs = args.slice(1)
    let kind = 'claude'
    let pathArg
    for (const a of subargs) {
      if (a === '--shell') kind = 'shell'
      else if (a === '--claude') kind = 'claude'
      else if (!pathArg) pathArg = a
    }
    const rawPath = pathArg || process.cwd()
    const expanded =
      rawPath === '~' || rawPath.startsWith('~/')
        ? (process.env.HOME || '') + rawPath.slice(1)
        : rawPath
    const cwd = path.resolve(expanded)
    try {
      await fs.access(cwd)
    } catch {
      die(`path não acessível: ${cwd}`)
    }
    await post('/workspace', { cwd, kind })
    process.stdout.write(`workspace aberto: ${cwd} (${kind})\n`)
    return
  }

  if (cmd !== 'show') {
    die(`comando desconhecido: ${cmd}\n${HELP}`)
  }

  const sub = args[1]
  if (!sub) die('show: esperado <arquivo> ou --md/--json/--me')

  if (sub === '--me') {
    const url = args[2]
    await post('/preview', { type: 'me', ...(url ? { url } : {}) })
    return
  }

  if (sub === '--md') {
    let content = args[2]
    if (content == null) die('--md: esperado <conteúdo> ou - (stdin)')
    if (content === '-') content = await readStdin()
    await post('/preview', { type: 'markdown', content })
    return
  }

  if (sub === '--json') {
    let raw = args[2]
    if (raw == null) die('--json: esperado <json> ou - (stdin)')
    if (raw === '-') raw = await readStdin()
    let value
    try {
      value = JSON.parse(raw)
    } catch (err) {
      die(`json inválido: ${err.message}`)
    }
    await post('/preview', { type: 'json', value })
    return
  }

  await showFile(sub)
}

main().catch((err) => {
  die(err.message || String(err))
})
