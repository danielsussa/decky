async function post(path, body, cardId) {
  const headers = { 'content-type': 'application/json' }
  if (process.env.DECKY_SESSION_ID) headers['x-deck-session-id'] = process.env.DECKY_SESSION_ID
  if (cardId) headers['x-deck-card-id'] = String(cardId)
  const res = await fetch(BASE + path, {
    method: 'POST',
    headers,
    body: JSON.stringify(body)
  })
  if (!res.ok) {
    const text = await res.text().catch(() => '')
    throw new Error(`decky ${path}: HTTP ${res.status} ${text}`)
  }
  return res.json()
}

async function get(path) {
  const headers = {}
  if (process.env.DECKY_SESSION_ID) headers['x-deck-session-id'] = process.env.DECKY_SESSION_ID
  const res = await fetch(BASE + path, { headers })
  if (!res.ok) {
    const text = await res.text().catch(() => '')
    throw new Error(`decky ${path}: HTTP ${res.status} ${text}`)
  }
  return res.json()
}

// Format the resolved {cardId, path} that POST /preview echoes back so the bot has a clear
// anchor for follow-up Edits ("card 'foo' at /abs/path/foo.md").
function describeResolved(verb, resolved) {
  const cardId = resolved && resolved.cardId
  const filePath = resolved && resolved.path
  if (cardId && filePath) return `${verb} card '${cardId}' at ${filePath} (Edit this file to update the card)`
  if (cardId) return `${verb} card '${cardId}'`
  if (filePath) return `${verb} at ${filePath}`
  return verb
}

async function handleCall(name, args) {
  const a = args || {}

  if (name === 'preview_show') {
    if (typeof a.path !== 'string') throw new Error('preview_show: path required')
    const ext = a.path.split('.').pop()?.toLowerCase()
    if (ext === 'md' || ext === 'markdown') {
      const r = await post('/preview', { type: 'markdown', path: a.path }, a.card)
      return describeResolved(`markdown rendered from ${a.path} as`, r)
    }
    if (ext === 'json') {
      const fs = require('node:fs/promises')
      const text = await fs.readFile(a.path, 'utf-8')
      let value = null
      try {
        value = JSON.parse(text)
      } catch {
        value = null
      }
      // Card-manifesto ({ kind:'manifest', widgets:[...] }) → abre como card HTML: o servidor
      // renderiza o .json pra HTML via o protocol card://. JSON comum → a árvore colapsável.
      if (value && value.kind === 'manifest' && Array.isArray(value.widgets)) {
        const r = await post('/preview', { type: 'html', path: a.path }, a.card)
        return describeResolved(`card manifest rendered from ${a.path} as`, r)
      }
      const r = await post('/preview', { type: 'json', value }, a.card)
      return describeResolved(`json rendered from ${a.path} as`, r)
    }
    if (ext === 'diff' || ext === 'patch') {
      const r = await post('/preview', { type: 'diff', path: a.path }, a.card)
      return describeResolved(`diff rendered from ${a.path} as`, r)
    }
    if (ext === 'xlsx') {
      const r = await post('/preview', { type: 'xlsx', path: a.path }, a.card)
      return describeResolved(`xlsx rendered from ${a.path} as`, r)
    }
    if (ext === 'html' || ext === 'htm') {
      const r = await post('/preview', { type: 'html', path: a.path }, a.card)
      return describeResolved(`html rendered from ${a.path} as`, r)
    }
    throw new Error(
      `unsupported file extension: .${ext}. Use preview_html/preview_json/preview_diff for inline content.`
    )
  }

  if (name === 'preview_diff') {
    if (typeof a.content !== 'string') throw new Error('preview_diff: content required')
    const r = await post('/preview', { type: 'diff', content: a.content, title: a.title }, a.card)
    return describeResolved('diff rendered as', r)
  }

  if (name === 'preview_html') {
    if (typeof a.content !== 'string') throw new Error('preview_html: content required')
    const r = await post(
      '/preview',
      { type: 'html', content: a.content, title: a.title },
      a.card
    )
    return describeResolved('html rendered as', r)
  }

  // Deprecated — preview_markdown was killed when MD as a card medium was retired (2026-06-16).
  // Kept as a guard so any stored call site / old prompt fails loudly instead of silently no-op.
  if (name === 'preview_markdown') {
    throw new Error(
      'preview_markdown was removed — cards are HTML now. Use preview_html(content) instead; ' +
      'you can include markdown-flavored body inside <article class="md-body"> if you want similar styling.'
    )
  }

  if (name === 'preview_json') {
    if (!('value' in a)) throw new Error('preview_json: value required')
    const r = await post('/preview', { type: 'json', value: a.value }, a.card)
    return describeResolved('json rendered as', r)
  }

  if (name === 'preview_me') {
    if (!LIVE_VIEW_ENABLED) throw new Error('preview_me is disabled')
    const r = await post('/preview', { type: 'me', ...(a.url ? { url: a.url } : {}) }, a.card)
    return describeResolved('switched to me live view as', r)
  }

  if (name === 'preview_hide') {
    await post('/preview/clear', {}, a.card)
    return 'preview cleared'
  }

  if (name === 'editor_open') {
    if (typeof a.path !== 'string') throw new Error('editor_open: path required')
    const r = await post('/preview', { type: 'editor', path: a.path }, a.card)
    return describeResolved(`editor opened on ${a.path} as`, r)
  }

  if (name === 'list_cards') {
    const sessionId = process.env.DECKY_SESSION_ID
    if (!sessionId) {
      throw new Error(
        'DECKY_SESSION_ID not set — this MCP server is not running inside a deck session'
      )
    }
    const data = await get(`/sessions/${encodeURIComponent(sessionId)}/cards`)
    const cards = (data && data.cards) || []
    const focusedId = data && data.focused
    const focused = focusedId ? cards.find((c) => c.id === focusedId) : null
    if (!focused) {
      return 'no card in focus — the user has not pointed at any card in this session. Other open tabs exist but are NOT context.'
    }
    const loc = focused.path ? ` → ${focused.path}` : focused.url ? ` → ${focused.url}` : ''
    const pin = focused.pinned ? ' [pinned]' : ''
    return `focused card (the user's current context):\n- ${focused.id} (${focused.type}) "${focused.title}"${loc}${pin}\n\nOther tabs exist in this session but are NOT context. Use search_cards to look up anything else.`
  }

  if (name === 'search_cards') {
    const query = typeof a.query === 'string' ? a.query : ''
    const limit = typeof a.limit === 'number' ? a.limit : 20
    const data = await post('/cards/search', { query, limit })
    const hits = (data && data.hits) || []
    if (hits.length === 0) {
      return query.trim()
        ? `no cards matched "${query}"`
        : 'no cards in this workspace yet'
    }
    const lines = hits.map((h) => {
      const head = query.trim()
        ? `- ${h.id} (score ${h.score}, line ${h.line}) "${h.title}" → ${h.path}`
        : `- ${h.id} "${h.title}" → ${h.path}`
      const snip = h.snippet ? `\n    ${h.snippet.replace(/\n/g, '\n    ')}` : ''
      return head + snip
    })
    return lines.join('\n')
  }

  if (name === 'card_backlinks') {
    const cardPath = typeof a.card_path === 'string' ? a.card_path : ''
    const data = await post('/cards/backlinks', cardPath ? { cardPath } : {})
    const hits = (data && data.hits) || []
    const target = (data && data.cardPath) || cardPath
    if (hits.length === 0) {
      return target
        ? `no cards reference ${target}`
        : 'no backlinks found'
    }
    const head = target ? `backlinks → ${target}\n` : ''
    const lines = hits.map((h) => {
      const main = `- ${h.id} (line ${h.line}) "${h.title}" → ${h.path}`
      const snip = h.snippet ? `\n    ${h.snippet.replace(/\n/g, '\n    ')}` : ''
      return main + snip
    })
    return head + lines.join('\n')
  }

  if (name === 'prompt_form') {
    if (!Array.isArray(a.fields) || a.fields.length === 0)
      throw new Error('prompt_form: fields[] required')
    const { randomUUID } = require('node:crypto')
    const formId = randomUUID()
    const spec = {
      formId,
      title: typeof a.title === 'string' ? a.title : undefined,
      description: typeof a.description === 'string' ? a.description : undefined,
      submitLabel: typeof a.submitLabel === 'string' ? a.submitLabel : undefined,
      fields: a.fields
    }
    // 1. Render the form card.
    await post('/preview', { type: 'form', spec }, a.card)
    // 2. Block until the user submits or cancels.
    const headers = { 'content-type': 'application/json' }
    if (process.env.DECKY_SESSION_ID) headers['x-deck-session-id'] = process.env.DECKY_SESSION_ID
    const timeoutMs = typeof a.timeoutMs === 'number' ? a.timeoutMs : 10 * 60 * 1000
    const res = await fetch(BASE + '/form/await', {
      method: 'POST',
      headers,
      body: JSON.stringify({ formId, timeoutMs })
    })
    if (!res.ok) {
      const text = await res.text().catch(() => '')
      throw new Error(`decky /form/await: HTTP ${res.status} ${text}`)
    }
    const outcome = await res.json()
    if (outcome.status === 'submitted') {
      return JSON.stringify({ status: 'submitted', values: outcome.values }, null, 2)
    }
    if (outcome.status === 'cancelled') {
      return JSON.stringify({ status: 'cancelled' })
    }
    return JSON.stringify({ status: 'timeout' })
  }

  if (name === 'list_widgets') {
    const data = await get('/widgets/list')
    return JSON.stringify(data && 'result' in data ? data.result : null, null, 2)
  }

  if (name === 'card_invoke') {
    if (typeof a.cardId !== 'string' || !a.cardId) throw new Error('card_invoke: cardId required')
    if (typeof a.widgetId !== 'string' || !a.widgetId) throw new Error('card_invoke: widgetId required')
    if (typeof a.op !== 'string' || !a.op) throw new Error('card_invoke: op required')
    // Some MCP clients JSON-stringify object arguments when the schema doesn't fully describe
    // them — be permissive and reparse if we got a string.
    let invokeArgs = a.args
    if (typeof invokeArgs === 'string') {
      try {
        invokeArgs = JSON.parse(invokeArgs)
      } catch {
        // Leave as-is if it's not JSON — the widget op can still inspect a raw string.
      }
    }
    const r = await post('/widget/invoke', {
      cardId: a.cardId,
      widgetId: a.widgetId,
      op: a.op,
      args: invokeArgs
    })
    return JSON.stringify(r && 'result' in r ? r.result : null)
  }

  if (name === 'card_get') {
    if (typeof a.cardId !== 'string' || !a.cardId) throw new Error('card_get: cardId required')
    if (typeof a.widgetId !== 'string' || !a.widgetId) throw new Error('card_get: widgetId required')
    if (typeof a.key !== 'string' || !a.key) throw new Error('card_get: key required')
    const r = await post('/widget/get', { cardId: a.cardId, widgetId: a.widgetId, key: a.key })
    return JSON.stringify(r && 'result' in r ? r.result : null)
  }

  // Browser-control tools — drive the focused web card via POST /web/act. Each returns the raw
  // JSON result as text so the agent gets structured data (snapshot elements, page text, etc.).
  if (name === 'browser_navigate') {
    if (typeof a.url !== 'string') throw new Error('browser_navigate: url required')
    return JSON.stringify(await post('/web/act', { action: 'navigate', url: a.url, cardId: a.card }))
  }
  if (name === 'browser_snapshot') {
    return JSON.stringify(await post('/web/act', { action: 'snapshot', cardId: a.card }))
  }
  if (name === 'browser_click') {
    if (typeof a.ref !== 'string') throw new Error('browser_click: ref required')
    return JSON.stringify(await post('/web/act', { action: 'click', ref: a.ref, cardId: a.card }))
  }
  if (name === 'browser_type') {
    if (typeof a.ref !== 'string' || typeof a.text !== 'string') {
      throw new Error('browser_type: ref and text required')
    }
    return JSON.stringify(
      await post('/web/act', { action: 'type', ref: a.ref, text: a.text, cardId: a.card })
    )
  }
  if (name === 'browser_read') {
    return JSON.stringify(await post('/web/act', { action: 'read', cardId: a.card }))
  }
  if (name === 'browser_eval') {
    if (typeof a.code !== 'string') throw new Error('browser_eval: code required')
    return JSON.stringify(await post('/web/act', { action: 'eval', code: a.code, cardId: a.card }))
  }

  throw new Error(`unknown tool: ${name}`)
}

;(async () => {
  const { Server } = await import('@modelcontextprotocol/sdk/server/index.js')
  const { StdioServerTransport } = await import('@modelcontextprotocol/sdk/server/stdio.js')
  const { CallToolRequestSchema, ListToolsRequestSchema } = await import(
    '@modelcontextprotocol/sdk/types.js'
  )

  const server = new Server(
    { name: 'decky', version: '0.1.0' },
    { capabilities: { tools: {} } }
  )

  server.setRequestHandler(ListToolsRequestSchema, async () => ({
    tools: TOOLS.filter((t) => LIVE_VIEW_ENABLED || t.name !== 'preview_me')
  }))

  server.setRequestHandler(CallToolRequestSchema, async (req) => {
    const { name, arguments: args } = req.params
    try {
      const text = await handleCall(name, args)
      return { content: [{ type: 'text', text }] }
    } catch (err) {
      return {
        content: [{ type: 'text', text: `error: ${err.message || String(err)}` }],
        isError: true
      }
    }
  })

  const transport = new StdioServerTransport()
  await server.connect(transport)
})().catch((err) => {
  // log to stderr — stdout is reserved for MCP protocol frames
  process.stderr.write(`dk-mcp fatal: ${err.message || err}\n`)
  process.exit(1)
})
